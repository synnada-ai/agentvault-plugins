{
  "mcpServers": {
    "vault": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch-mcp.sh",
        "claude-code"
      ],
      "env": {
        "VAULT_MCP_TOKEN": "${user_config.VAULT_MCP_TOKEN}",
        "VAULT_HOME": "${user_config.VAULT_HOME}",
        "VAULT_APP_PATH": "${user_config.VAULT_APP_PATH}"
      }
    }
  }
}
